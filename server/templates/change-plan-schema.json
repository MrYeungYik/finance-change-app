{
  "version": 1,
  "templateFile": "change-plan-template.docx",
  "changeMethodOptions": [
    "自动化部署",
    "手工部署",
    "自动化+手工部署"
  ],
  "headerFields": [
    {
      "key": "requirementText",
      "label": "变更需求",
      "type": "lines"
    },
    {
      "key": "changeSystem",
      "label": "变更系统",
      "type": "readonly"
    },
    {
      "key": "expectedChangeDate",
      "label": "期望变更日期",
      "type": "date"
    },
    {
      "key": "changeMethod",
      "label": "变更方式",
      "type": "select"
    }
  ],
  "serverTable": {
    "key": "serverRows",
    "columns": [
      {
        "key": "assetName",
        "label": "资产名称",
        "control": "select"
      },
      {
        "key": "ip",
        "label": "IP 地址",
        "control": "multiSelect"
      },
      {
        "key": "username",
        "label": "用户名",
        "control": "input"
      },
      {
        "key": "assetType",
        "label": "资产类型",
        "control": "select"
      }
    ],
    "sampleRows": [
      {
        "assetName": "代销系统应用服务器",
        "ip": "*.*.1.27/28/29、*.*.1.125/127/128",
        "username": "ifm30/cdadmin",
        "assetType": "应用服务器"
      },
      {
        "assetName": "代销系统前置机",
        "ip": "*.*.200.12",
        "username": "admin",
        "assetType": "前置机"
      },
      {
        "assetName": "代销系统数据库",
        "ip": "*.*.88.14",
        "username": "hsfss30",
        "assetType": "数据库"
      }
    ]
  },
  "multiSelects": [
    {
      "key": "dbChanges",
      "suffixKey": "dbChangesSuffix",
      "label": "数据库变更",
      "heading": "（一）数据库变更",
      "placeholder": "XQ-2026-0726、对方的"
    },
    {
      "key": "autoDeployChanges",
      "suffixKey": "autoDeployChangesSuffix",
      "label": "自动化部署",
      "heading": "（二）自动化部署",
      "placeholder": "XQ-2026-0726、对方的点"
    },
    {
      "key": "configFileChanges",
      "suffixKey": "configFileChangesSuffix",
      "label": "修改配置文件",
      "heading": "（三）修改配置文件",
      "placeholder": "XQ-2026-0726、对方的点"
    }
  ],
  "manualFields": [
    {
      "key": "packageFile",
      "label": "变更包",
      "section": "变更文件清单",
      "kind": "input",
      "placeholder": "jjxtyyyymmdd.zip"
    },
    {
      "key": "packageNote",
      "label": "说明",
      "section": "变更文件清单",
      "kind": "textarea",
      "placeholder": "包含应用上线包及 SQL 脚本，SQL 脚本位于包内 SQL 目录。"
    }
  ],
  "stepTables": [
    {
      "key": "dbSteps",
      "legacyKey": "dbStep1",
      "templateTag": "dbStep1",
      "label": "数据库变更步骤",
      "section": "数据库变更",
      "placeholder": "使用 hsfss30（query 备份使用）用户登录数据库服务器 10.0.0.14"
    },
    {
      "key": "configSteps",
      "legacyKey": "configStep1",
      "templateTag": "configStep1",
      "label": "配置文件修改步骤",
      "section": "修改配置文件",
      "placeholder": "参照附件修改相关配置文件"
    },
    {
      "key": "manualSteps",
      "legacyKey": "manualStep1",
      "templateTag": "manualStep1",
      "label": "手工变更步骤",
      "section": "手工变更",
      "placeholder": "使用 ifm30 用户通过 SSH 登录应用服务器"
    },
    {
      "key": "appRollbackSteps",
      "legacyKey": "appRollbackIntro",
      "templateTag": "appRollbackIntro",
      "label": "应用回退步骤",
      "section": "应用回退",
      "placeholder": "停止相关应用服务后按顺序执行"
    },
    {
      "key": "dbRollbackSteps",
      "legacyKey": "dbRollback",
      "templateTag": "dbRollback",
      "label": "数据库回退步骤",
      "section": "数据库回退",
      "placeholder": "执行回退脚本 回退.sql（如有）"
    }
  ],
  "verificationField": {
    "key": "verificationPlan",
    "label": "变更验证方案",
    "section": "变更验证方案",
    "kind": "textarea",
    "placeholder": "取自变更申请表的变更验证方案"
  },
  "fixedSections": [
    {
      "title": "六、变更注意事项",
      "lines": [
        "1. 变更前确认变更包完整、数据库已备份、相关服务器可正常登录。",
        "2. 严格按变更手册中的顺序执行；自动化部署失败时再执行手工变更。",
        "3. 回退前先停止相关服务，回退完成后按启动顺序重新启动并验证。",
        "4. 变更和回退过程应做好操作记录，异常情况及时上报。"
      ]
    }
  ]
}
